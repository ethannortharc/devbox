{
  "title": "devbox — glass box",
  "uid": "devbox-obs",
  "tags": ["devbox", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(devbox_build_info, job)",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events dropped",
      "description": "§7.3 — events are never silently dropped. Anything above zero means the collector could not keep up, and the timeline has a hole in it.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(increase(devbox_events_dropped_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "dropped" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agents connected",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "devbox_agents_connected_total{job=\"$job\"}", "legendFormat": "agents" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Boxes running",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "devbox_boxes{job=\"$job\", status=\"running\"}", "legendFormat": "running" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events rejected",
      "description": "Events that did not decode or validate. A non-zero rate means an agent and collector disagree about the schema.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(increase(devbox_events_rejected_total{job=\"$job\"}[$__rate_interval]))", "legendFormat": "rejected" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event rate",
      "description": "Received vs stored. A persistent gap is backpressure.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(devbox_events_received_total{job=\"$job\"}[$__rate_interval])", "legendFormat": "received/s" },
        { "expr": "rate(devbox_events_stored_total{job=\"$job\"}[$__rate_interval])", "legendFormat": "stored/s" },
        { "expr": "rate(devbox_events_dropped_total{job=\"$job\"}[$__rate_interval])", "legendFormat": "dropped/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Events by type",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "devbox_events_by_type{job=\"$job\"}", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Boxes by status",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "devbox_boxes{job=\"$job\"}", "legendFormat": "{{status}}" }
      ]
    }
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ]
}
