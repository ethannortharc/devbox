! Generated by devbox labkit for fabric '{{ fabric }}'
! Device {{ device }} ({{ role }}) — AS {{ asn }}, router-id {{ loopback.split('/')[0] }}
!
frr defaults datacenter
hostname {{ device }}
log stdout
!
interface lo
 ip address {{ loopback }}
!
{% for iface in interfaces %}
interface {{ iface.name }}
{% if iface.address %}
 ip address {{ iface.address }}
{% endif %}
 no shutdown
!
{% endfor %}
router bgp {{ asn }}
 bgp router-id {{ loopback.split('/')[0] }}
 no bgp ebgp-requires-policy
 bgp bestpath as-path multipath-relax
 timers bgp 3 9
{% for iface in interfaces %}
{% if iface.peers %}
 neighbor {{ iface.name }} interface remote-as external
{% endif %}
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ loopback }}
{% for network in networks %}
  network {{ network }}
{% endfor %}
{% for iface in interfaces %}
{% if iface.peers %}
  neighbor {{ iface.name }} activate
{% endif %}
{% endfor %}
  maximum-paths 8
 exit-address-family
!
